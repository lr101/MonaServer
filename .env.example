# Copy to .env and replace all example credentials. .env is ignored by Git.
# Public consumer hostname; Compose derives the email login callback URL from it.
WEB_HOST=stick-it.lr-projects.de
# APP_IMAGE=ghcr.io/lr101/monaserver-app:develop
# Configure this entrypoint on Traefik so it is reachable only from the private network.
ADMIN_HOST=admin.thinkpad.lr-project.de
ADMIN_TRAEFIK_ENTRYPOINT=websecure-internal
TRAEFIK_NETWORK=traefik
POSTGRES_USER=monaserver
POSTGRES_PASSWORD=
JWT_SECRET=
TOKEN_ADMIN_USERNAME=admin
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
ADMIN_TOTP_ENCRYPTION_KEY=
ADMIN_SESSION_HMAC_KEY=
# Configure the first administrator in the Go server environment, then remove
# these three values after the account is created.
# ADMIN_BOOTSTRAP_USERNAME=admin
# ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-unique-password
# ADMIN_BOOTSTRAP_TOTP_SECRET=replace-with-a-base32-seed
