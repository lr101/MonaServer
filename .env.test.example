# Copy this file to .env.test and replace the placeholders before starting
# docker-compose.test.yml or the native agent profile. Keep .env.test local;
# it is gitignored.
TEST_DB_USER=monaserver
# Keep this value URL-safe because the Compose file embeds it in DATABASE_URL.
TEST_DB_PASSWORD=replace-with-a-local-db-password
TEST_DB_NAME=monaserver_test
TEST_JWT_SECRET=replace-with-a-local-jwt-secret
TEST_RUSTFS_ACCESS_KEY=replace-with-a-local-rustfs-access-key
TEST_RUSTFS_SECRET_KEY=replace-with-a-local-rustfs-secret-key
# Origins allowed to download presigned objects from the local Flutter web app.
TEST_RUSTFS_CORS_ALLOWED_ORIGINS=http://127.0.0.1:4173,http://localhost:4173
