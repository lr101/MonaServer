# Uncomment this line to define a global platform for your project
platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

use_frameworks!

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

# camera_avfoundation 0.10.2 still references notification properties that
# disappeared from the iOS 18 SDK's Swift importer. Keep the upstream package
# version while applying the source-compatible notification names at pod setup.
def patch_camera_avfoundation
  source_path = File.expand_path(
    '.symlinks/plugins/camera_avfoundation/ios/camera_avfoundation/Sources/' \
      'camera_avfoundation/DefaultCamera.swift',
    __dir__
  )
  return unless File.file?(source_path)

  source = File.read(source_path)
  patched_source = source
    .gsub(
      'AVCaptureSession.wasInterruptedNotification',
      'NSNotification.Name("AVCaptureSessionWasInterruptedNotification")'
    )
    .gsub(
      'AVCaptureSession.runtimeErrorNotification',
      'NSNotification.Name("AVCaptureSessionRuntimeErrorNotification")'
    )

  return if patched_source == source

  File.write(source_path, patched_source)
  puts 'Patched camera_avfoundation notification names for the iOS 18 SDK.'
end

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  pod 'PhoneNumberKit', '~> 4.3.0'
  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
end

post_install do |installer|
  patch_camera_avfoundation

  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
  end
end
